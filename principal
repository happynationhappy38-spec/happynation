<section id="produtos" class="produtos">
    <div class="produto">
        <img src="https://via.placeholder.com/300" alt="Camiseta">
        <h3>Camiseta Premium</h3>
        <span>R$ 79,90</span>
        <button onclick="comprar()">Comprar</button>
    </div>

    <div class="produto">
        <img src="https://via.placeholder.com/300" alt="Calça Jeans">
        <h3>Calça Jeans</h3>
        <span>R$ 159,90</span>
        <button onclick="comprar()">Comprar</button>
    </div>

    <div class="produto">
        <img src="https://via.placeholder.com/300" alt="Moletom">
        <h3>Moletom Oversize</h3>
        <span>R$ 199,90</span>
        <button onclick="comprar()">Comprar</button>
    </div>
</section>

<section id="contato" class="contato">
    <h2>Fale Conosco</h2>
    <p>WhatsApp: <strong>(11) 94195-7068</strong></p>
</section>

<footer>
    <p>© 2026 Happy Nation — Todos os direitos reservados</p>
</footer>

<a class="whatsapp" href="https://wa.me/5511941957068" target="_blank">💬</a>

