* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background: #f4f4f4;
}

header {
    background: #111;
    color: #fff;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

nav a {
    color: #fff;
    margin-left: 20px;
    text-decoration: none;
    font-weight: 500;
}

.hero {
    background: linear-gradient(135deg, #000, #333);
    color: #fff;
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 2.5em;
}

.hero p {
    margin: 15px 0;
}

.btn {
    background: #fff;
    color: #000;
    padding: 12px 25px;
    text-decoration: none;
    border-radius: 30px;
    font-weight: 600;
}

.produtos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    padding: 60px;
}

.produto {
    background: #fff;
    border-radius: 15px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
}

.produto img {
    width: 100%;
    border-radius: 10px;
}

.produto h3 {
    margin: 15px 0 5px;
}

.produto span {
    font-weight: bold;
}

.produto button {
    margin-top: 15px;
    background: #111;
    color: #fff;
    border: none;
    padding: 12px;
    width: 100%;
    border-radius: 30px;
    cursor: pointer;
}

.produto button:hover {
    background: #333;
}

.contato {
    background: #fff;
    text-align: center;
    padding: 40px;
}

footer {
    background: #111;
    color: #fff;
    text-align: center;
    padding: 15px;
}

.whatsapp {
    position: fixed;
    bottom: 20px;
    right: 20px;
    background: #25D366;
    color: #fff;
    font-size: 28px;
    padding: 15px;
    border-radius: 50%;
    text-decoration: none;
}
